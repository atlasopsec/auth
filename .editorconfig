# Shared editor settings. Copy to the project root as .editorconfig.
# See: standards/code-style.md in jakefrenzel/engineering-standards

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go and Makefiles use tabs
[{*.go,go.mod,go.sum,Makefile}]
indent_style = tab
indent_size = 4

# Trailing spaces can be meaningful in Markdown (line breaks)
[*.md]
trim_trailing_whitespace = false
