# The Go API's private address. On Railway: http://api.railway.internal:8080
API_URL=http://localhost:8080
# The header your hosting edge puts the browser's IP in. Railway: x-real-ip
CLIENT_IP_HEADER=x-real-ip
# The sign-in providers turned on in the Go API, e.g. google,github
OAUTH_PROVIDERS=
# The mobile app's deep link for finishing a sign-in, if there's an app
# MOBILE_OAUTH_REDIRECT_URL=exampleapp://oauth
